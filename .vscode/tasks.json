{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "StimTrace: install dependencies",
      "type": "shell",
      "command": "${env:USERPROFILE}/emt-env/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements-desktop.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "StimTrace: build Windows application",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build_windows.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
